{
  "compilerOptions": {
    "target": "es2021",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": [
      "dom",
      "esnext"
    ],
    "outDir": "../../../build",
    "rootDir": ".",
    "strict": true,
    "strictPropertyInitialization": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "useDefineForClassFields": false,
    "sourceMap": true
  },
  "include": [
    "./**/*.ts"
  ]
}
